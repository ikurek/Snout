<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets "Open in PostHog" find a browser to hand links to, instead of Snout itself. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".SnoutApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snout">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Snout.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                PostHog cloud links. posthog.com doesn't publish an assetlinks.json for Snout, so these can't be
                verified: Android only sends them here once the user adds them under "Open by default".
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="us.posthog.com" />
                <data android:host="eu.posthog.com" />
                <data android:host="app.posthog.com" />
                <data android:pathPrefix="/project/" />
            </intent-filter>
            <!-- Sharing a link to Snout, the way in for self-hosted instances. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (Glance). Data from the person's PostHog shows on the home screen only, never the lock screen. -->
        <receiver
            android:name=".appwidget.AnalyticsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_analytics_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/analytics_widget_info" />
        </receiver>
        <receiver
            android:name=".appwidget.InsightWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_insight_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/insight_widget_info" />
        </receiver>
        <!-- The launcher opens these to set a widget up, so they have to be exported. -->
        <activity
            android:name=".appwidget.AnalyticsWidgetConfigurationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Snout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".appwidget.InsightWidgetConfigurationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Snout">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>